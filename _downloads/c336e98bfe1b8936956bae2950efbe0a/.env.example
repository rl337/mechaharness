#!/usr/bin/env bash
# MechaHarness local operator env — copy to ``.env/env.sh`` (gitignored) and fill blanks.
#   mkdir -p .env && cp .env.example .env/env.sh && chmod +x .env/env.sh
# Never commit real tokens, LAN IPs, or absolute home paths.

# Resolve repo root when sourced from bash or zsh.
if [ -n "${ZSH_VERSION:-}" ]; then
  # shellcheck disable=SC2296
  _THIS="${(%):-%x}"
elif [ -n "${BASH_SOURCE[0]:-}" ]; then
  _THIS="${BASH_SOURCE[0]}"
else
  _THIS="$0"
fi
_REPO_ROOT="$(cd "$(dirname "$_THIS")/.." && pwd)"
# When copied to ``.env/env.sh``, dirname is ``.env`` → parent is repo root.
# When sourced from this example at repo root, adjust:
if [ "$(basename "$(dirname "$_THIS")")" != ".env" ]; then
  _REPO_ROOT="$(cd "$(dirname "$_THIS")" && pwd)"
fi
unset _THIS

_mecha_unset_empty() {
  local key val
  for key in "$@"; do
    eval "val=\${$key-}"
    if [[ -z "$val" ]]; then
      unset "$key" 2>/dev/null || true
    fi
  done
}

# --- Reason / OpenAI-compat ---
export MECHA_INFERENCE_BACKEND="${MECHA_INFERENCE_BACKEND:-openai_local}"
export MECHA_BASE_URL="${MECHA_BASE_URL:-http://127.0.0.1:1234/v1}"
export MECHA_MODEL="${MECHA_MODEL:-}"
export MECHA_API_KEY="${MECHA_API_KEY:-local}"
export MECHA_HARNESS_FAMILY="${MECHA_HARNESS_FAMILY:-tool_loop}"
export MECHA_MAX_TOKENS="${MECHA_MAX_TOKENS:-}"
export MECHA_HTTP_TIMEOUT_SECONDS="${MECHA_HTTP_TIMEOUT_SECONDS:-300}"
export MECHA_NATIVE_TOOLS="${MECHA_NATIVE_TOOLS:-}"

# --- Guided coding MCP / workspace ---
export MECHA_MCP_HOST="${MECHA_MCP_HOST:-project_coding}"
export MECHA_WORKSPACE="${MECHA_WORKSPACE:-$_REPO_ROOT}"
export MECHA_GENERATOR_STORE="${MECHA_GENERATOR_STORE:-$_REPO_ROOT/.mechaharness/generator-runs.json}"
export MECHA_GENERATOR_CONTROLLER="${MECHA_GENERATOR_CONTROLLER:-cursor-agent}"

# --- GitHub HTTP PR (GitHubConnectionConfig) ---
# Prefer exporting MECHA_GITHUB_TOKEN from the shell / secret store — do not hardcode.
export MECHA_GITHUB_TOKEN="${MECHA_GITHUB_TOKEN:-}"
export GITHUB_TOKEN="${GITHUB_TOKEN:-${MECHA_GITHUB_TOKEN:-}}"
export MECHA_GITHUB_API_BASE="${MECHA_GITHUB_API_BASE:-https://api.github.com}"
export MECHA_GITHUB_OWNER="${MECHA_GITHUB_OWNER:-}"
export MECHA_GITHUB_REPO="${MECHA_GITHUB_REPO:-}"
export MECHA_GITHUB_TIMEOUT_SECONDS="${MECHA_GITHUB_TIMEOUT_SECONDS:-60}"

# --- Judge lane (optional) ---
export MECHA_JUDGE_BASE_URL="${MECHA_JUDGE_BASE_URL:-}"
export MECHA_JUDGE_PATH="${MECHA_JUDGE_PATH:-/v1/systemone}"
export MECHA_JUDGE_MODEL="${MECHA_JUDGE_MODEL:-}"
export MECHA_JUDGE_API_KEY="${MECHA_JUDGE_API_KEY:-}"
export MECHA_JUDGE_TIMEOUT_SECONDS="${MECHA_JUDGE_TIMEOUT_SECONDS:-}"

# --- Live story / suite knobs (optional) ---
export MECHA_STORY_BACKEND="${MECHA_STORY_BACKEND:-}"
export MECHA_STORY_MODEL="${MECHA_STORY_MODEL:-}"
export MECHA_LIVE_OPENAI_COMPAT="${MECHA_LIVE_OPENAI_COMPAT:-}"
export MECHA_LIVE_JUDGE="${MECHA_LIVE_JUDGE:-}"
export MECHA_SUITE_RUN_ID="${MECHA_SUITE_RUN_ID:-}"
export MECHA_SUITE_FROM="${MECHA_SUITE_FROM:-}"
export MECHA_SUITE_RUNS_DIR="${MECHA_SUITE_RUNS_DIR:-}"

export PYTHONPATH="${PYTHONPATH:-$_REPO_ROOT/src}"
export PYTHONUNBUFFERED="${PYTHONUNBUFFERED:-1}"

_mecha_unset_empty \
  MECHA_MODEL MECHA_MAX_TOKENS MECHA_NATIVE_TOOLS \
  MECHA_GITHUB_TOKEN GITHUB_TOKEN MECHA_GITHUB_OWNER MECHA_GITHUB_REPO \
  MECHA_JUDGE_BASE_URL MECHA_JUDGE_MODEL MECHA_JUDGE_API_KEY MECHA_JUDGE_TIMEOUT_SECONDS \
  MECHA_STORY_BACKEND MECHA_STORY_MODEL MECHA_LIVE_OPENAI_COMPAT MECHA_LIVE_JUDGE \
  MECHA_SUITE_RUN_ID MECHA_SUITE_FROM MECHA_SUITE_RUNS_DIR

unset _REPO_ROOT
unset -f _mecha_unset_empty
